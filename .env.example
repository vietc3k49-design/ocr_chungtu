# ---- API vision chuẩn OpenAI (NVIDIA NIM) — dùng bởi tools/vlm_gateway.py
# Key nvapi-* KHÔNG dùng được với gateway beeknoee (401); phải gọi thẳng NVIDIA.
# NIM giới hạn ảnh nhúng ~180KB base64 -> module tự thu nhỏ, xem VLM_MAX_EDGE.
# KHÔNG chia sẻ file này. Bên thứ ba nằm giữa ta và nhà cung cấp model:
# chỉ dùng với ảnh DEMO, chứng từ thật của KIDO phải có KIDO đồng ý trước.
VLM_API_KEY=your_vlm_api_key_here
VLM_API=https://platform-api.beeknoee.com/v1/chat/completions
VLM_MODEL=gemini-2.5-flash-lite
VLM_MAX_EDGE=1400

# ---- Key Google gọi thẳng — dùng bởi ocr-llm-sig-gemini-test.ipynb
# Lấy key tại https://aistudio.google.com -> Get API key.
#GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
