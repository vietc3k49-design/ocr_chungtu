# Sao chép thành .env rồi điền. KHÔNG đưa .env lên git.
# Tạo bằng: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=doi-thanh-chuoi-ngau-nhien-dai
POSTGRES_USER=kido
POSTGRES_PASSWORD=kido
POSTGRES_DB=kido
# Cổng PostgreSQL ánh xạ ra host (mặc định 5433 để tránh đụng 5432 của service khác)
POSTGRES_HOST_PORT=5433

# Mail — dev dùng Mailpit (không auth). Triển khai thật: đổi sang SMTP thật.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
MAIL_FROM=KIDO OCR <no-reply@kido-ocr.local>
PUBLIC_BASE_URL=http://localhost:8080
COOKIE_SECURE=false

# Admin đầu tiên (scripts/seed_demo.py)
ADMIN_EMAIL=admin@kido-ocr.local
ADMIN_PASSWORD=doi-mat-khau-admin

WORKER_STAGE1_PROCESSES=4

# Giới hạn đăng nhập sai (mặc định: 5 lần sai/email hoặc 20 lần sai/IP trong 15 phút ⇒ khóa 15 phút)
LOGIN_MAX_FAILS_PER_EMAIL=5
LOGIN_MAX_FAILS_PER_IP=20
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
